# Maintainer: webview2-gtk contributors
# Build (MSYS2 UCRT64):
#   cd packaging/msys2
#   makepkg-mingw -C -f --noconfirm
# Install (signed releases): trust packaging/msys2/webview2gtk-packager.gpg, then
#   pacman -U https://github.com/roojs/webview2-gtk/releases/download/vX.Y.Z/mingw-w64-ucrt-x86_64-webview2gtk-X.Y.Z-1-any.pkg.tar.zst
#
# Or from repo root:
#   ./scripts/build-pacman-package.sh
#   PKGVER=X.Y.Z ./scripts/build-pacman-package.sh --sign

pkgname=mingw-w64-ucrt-x86_64-webview2gtk
pkgver=0.5.9
pkgrel=1
pkgdesc="GTK 4 WebView2 widget for Windows (Edge Chromium)"
arch=('any')
url="https://github.com/roojs/webview2-gtk"
license=('LGPL-2.1-or-later')
depends=(
  'mingw-w64-ucrt-x86_64-gtk4'
  'mingw-w64-ucrt-x86_64-libgee'
  'mingw-w64-ucrt-x86_64-libsoup3'
)
makedepends=(
  'mingw-w64-ucrt-x86_64-gcc'
  'mingw-w64-ucrt-x86_64-vala'
  'mingw-w64-ucrt-x86_64-meson'
  'mingw-w64-ucrt-x86_64-ninja'
  'mingw-w64-ucrt-x86_64-pkg-config'
  'mingw-w64-ucrt-x86_64-curl'
)
options=('!strip' '!emptydirs')
source=()
sha256sums=()

_repo_root() {
  cd "$(dirname "${BASH_SOURCE[0]}")/../.."
  pwd
}

# CI sets WV2GTK_PREBUILT_DESTDIR to a meson --destdir tree normalized to
# …/ucrt64/… (see scripts/msys2-normalize-destdir.sh). Must not be packaging/msys2/pkg
# — that collides with makepkg's $pkgdir.
prepare() {
  if [[ -n "${WV2GTK_PREBUILT_DESTDIR:-}" ]]; then
    return 0
  fi
  local root="$(_repo_root)"
  rm -rf "$srcdir/webview2-gtk"
  mkdir -p "$srcdir/webview2-gtk"

  # srcdir is packaging/msys2/src — exclude it so we never copy the tree into itself.
  # Use tar only (no git): UCRT64 makepkg does not have /usr/bin/git on PATH.
  (cd "$root" && tar -cf - \
    --exclude='./packaging/msys2/src' \
    --exclude='./packaging/msys2/pkg' \
    --exclude='./packaging/msys2/prebuilt' \
    --exclude='./build' \
    --exclude='./build-remote' \
    --exclude='./dist' \
    --exclude='./.git' \
    --exclude='./packaging/msys2/*.pkg.tar.zst' \
    .) | (cd "$srcdir/webview2-gtk" && tar -xf -)
}

build() {
  if [[ -n "${WV2GTK_PREBUILT_DESTDIR:-}" ]]; then
    return 0
  fi
  cd "$srcdir/webview2-gtk"
  ./scripts/vendor-webview2-sdk.sh
  # Portable /ucrt64 — do not use a resolved absolute MSYS2 root (CI runners).
  # Local makepkg: library only. Release CI builds demos via ci-windows-release-build.sh.
  meson setup build --prefix=/ucrt64 -Dexamples=false
  meson compile -C build
}

package() {
  if [[ -n "${WV2GTK_PREBUILT_DESTDIR:-}" ]]; then
    if [[ ! -d "${WV2GTK_PREBUILT_DESTDIR}" ]]; then
      echo "PKGBUILD: WV2GTK_PREBUILT_DESTDIR missing: ${WV2GTK_PREBUILT_DESTDIR}" >&2
      return 1
    fi
    case "${pkgdir}" in
      "${WV2GTK_PREBUILT_DESTDIR}"|"${WV2GTK_PREBUILT_DESTDIR}"/*)
        echo "PKGBUILD: WV2GTK_PREBUILT_DESTDIR must not be under makepkg \$pkgdir (${pkgdir})" >&2
        return 1
        ;;
    esac
    case "${WV2GTK_PREBUILT_DESTDIR}" in
      "${pkgdir}"|"${pkgdir}"/*)
        echo "PKGBUILD: WV2GTK_PREBUILT_DESTDIR (${WV2GTK_PREBUILT_DESTDIR}) collides with \$pkgdir" >&2
        return 1
        ;;
    esac
    mkdir -p "$pkgdir"
    cp -a "${WV2GTK_PREBUILT_DESTDIR}/." "$pkgdir/"
    return 0
  fi

  cd "$srcdir/webview2-gtk"
  meson install -C build --destdir="$pkgdir"
  "$srcdir/webview2-gtk/scripts/msys2-normalize-destdir.sh" "$pkgdir"

  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "$pkgdir/ucrt64/share/licenses/${pkgname}/LICENSE"
  fi
}
